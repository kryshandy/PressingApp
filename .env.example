# =====================================================================
#  Pressing Éclat — configuration locale
#  Copiez ce fichier en `.env` puis complétez les valeurs.
#  Le fichier `.env` n'est jamais versionné.
# =====================================================================

# ---------- Réseau / applications ----------
# Adresse d'ÉCOUTE du serveur API (0.0.0.0 = toutes les cartes réseau). Cette valeur ne dit pas
# comment les clients joignent l'API : elle est lue uniquement par src/Pressing.Api au démarrage.
# L'option --urls et ASPNETCORE_URLS restent prioritaires.
PRESSING_API_URL=http://0.0.0.0:5180
# Adresse PUBLIQUE de l'API utilisée par le Desktop et le site web pour joindre l'API.
# Exemple derrière un reverse proxy HTTPS : https://api.exemple.local (alors que l'API écoute sur
# http://0.0.0.0:5180 derrière le proxy). Ne pas mélanger avec PRESSING_API_URL.
PRESSING_PUBLIC_API_URL=http://localhost:5180
# Proxys de confiance pour X-Forwarded-For / X-Forwarded-Proto (IP séparées par des virgules).
# La boucle locale (127.0.0.1, ::1) est toujours de confiance : à renseigner seulement si le site web
# ou un reverse proxy est sur une autre machine. Les en-têtes venant d'ailleurs sont ignorés.
# Sert à la limitation de débit par visiteur et au cookie Secure derrière un proxy TLS.
# X-Real-IP n'est pas utilisé par l'application.
PRESSING_TRUSTED_PROXIES=
# URL publique du site (liens dans les e-mails)
PRESSING_WEB_URL=http://localhost:5181
ASPNETCORE_ENVIRONMENT=Development

# ---------- Base de données SQLite ----------
# Par défaut : %LOCALAPPDATA%\Pressing\pressing.db
# En production sur le serveur, gardez le fichier sur un disque local
# (ne partagez pas le fichier .db via SMB : les clients passent par l'API).
PRESSING_DB_PATH=
PRESSING_BACKUP_PATH=

# ---------- Sécurité ----------
# Clé de signature des jetons (64 caractères aléatoires recommandés).
# Laissez vide : une clé est générée et conservée dans jwt.key, à côté du fichier de base de données.
PRESSING_JWT_KEY=
# Compte administrateur créé au premier démarrage
PRESSING_ADMIN_USERNAME=admin
PRESSING_ADMIN_PASSWORD=Admin@2026!
# Données de démonstration (clients, commandes, paiements)
PRESSING_SEED_DEMO=true

# ---------- E-mail (Resend ou SMTP / mot de passe d'application) ----------
# auto | resend | smtp | simulated
EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Pressing Éclat
# Solution de repli : Gmail, Outlook, OVH... avec un mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_REPLY_TO=
# Traitement automatique de la file d'e-mails
EMAIL_BACKGROUND_ENABLED=true

# ---------- Assistant vocal (lot M2) ----------
# Interrupteur général : false désactive les routes /api/assistant/* (réponse 503).
ASSISTANT_ENABLED=true
# Confiance minimale (0 à 1) en dessous de laquelle l'assistant répond « je n'ai pas compris ».
ASSISTANT_CONFIDENCE_THRESHOLD=0.6
