# =====================================================================
#  Pressing Éclat — configuration locale
#  Copiez ce fichier en `.env` puis complétez les valeurs.
#  Le fichier `.env` n'est jamais versionné.
# =====================================================================

# ---------- Réseau / applications ----------
# URL de l'API (0.0.0.0 pour être joignable depuis le réseau local)
PRESSING_API_URL=http://0.0.0.0:5180
# URL utilisée par le desktop et le site web pour joindre l'API
PRESSING_PUBLIC_API_URL=http://localhost:5180
# URL publique du site (liens dans les e-mails)
PRESSING_WEB_URL=http://localhost:5181
ASPNETCORE_ENVIRONMENT=Development

# ---------- Base de données SQLite ----------
# Par défaut : <racine>/data/pressing.db
# En production sur le serveur, gardez le fichier sur un disque local
# (ne partagez pas le fichier .db via SMB : les clients passent par l'API).
PRESSING_DB_PATH=
PRESSING_BACKUP_PATH=

# ---------- Sécurité ----------
# Clé de signature des jetons (64 caractères aléatoires recommandés).
# Laissez vide : une clé est générée et conservée dans data/jwt.key.
PRESSING_JWT_KEY=
# Compte administrateur créé au premier démarrage
PRESSING_ADMIN_USERNAME=admin
PRESSING_ADMIN_PASSWORD=Admin@2026!
# Données de démonstration (clients, commandes, paiements)
PRESSING_SEED_DEMO=true

# ---------- E-mail (Resend ou SMTP / mot de passe d'application) ----------
# auto | resend | smtp | simulated
EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Pressing Éclat
# Solution de repli : Gmail, Outlook, OVH... avec un mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_REPLY_TO=
# Traitement automatique de la file d'e-mails
EMAIL_BACKGROUND_ENABLED=true
