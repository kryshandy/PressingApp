# =====================================================================
#  Pressing Éclat — configuration locale
#  Copiez ce fichier en `.env` puis complétez les valeurs.
#  Le fichier `.env` n'est jamais versionné.
# =====================================================================

# ---------- Réseau / applications ----------
# Adresse d'ÉCOUTE du serveur API (0.0.0.0 = toutes les cartes réseau). Cette valeur ne dit pas
# comment les clients joignent l'API : elle est lue uniquement par src/Pressing.Api au démarrage.
# L'option --urls et ASPNETCORE_URLS restent prioritaires.
PRESSING_API_URL=http://0.0.0.0:5180
# Adresse PUBLIQUE de l'API utilisée par le Desktop et le site web pour joindre l'API.
# Exemple derrière un reverse proxy HTTPS : https://api.exemple.local (alors que l'API écoute sur
# http://0.0.0.0:5180 derrière le proxy). Ne pas mélanger avec PRESSING_API_URL.
PRESSING_PUBLIC_API_URL=http://localhost:5180
# Proxys de confiance pour X-Forwarded-For / X-Forwarded-Proto (IP séparées par des virgules).
# La boucle locale (127.0.0.1, ::1) est toujours de confiance : à renseigner seulement si le site web
# ou un reverse proxy est sur une autre machine. Les en-têtes venant d'ailleurs sont ignorés.
# Sert à la limitation de débit par visiteur et au cookie Secure derrière un proxy TLS.
# X-Real-IP n'est pas utilisé par l'application.
PRESSING_TRUSTED_PROXIES=
# URL publique du site (liens dans les e-mails)
PRESSING_WEB_URL=http://localhost:5181
ASPNETCORE_ENVIRONMENT=Development

# ---------- Base de données SQLite ----------
# Par défaut : %LOCALAPPDATA%\Pressing\pressing.db
# En production sur le serveur, gardez le fichier sur un disque local
# (ne partagez pas le fichier .db via SMB : les clients passent par l'API).
PRESSING_DB_PATH=
PRESSING_BACKUP_PATH=

# ---------- Sécurité ----------
# Clé de signature des jetons (64 caractères aléatoires recommandés).
# Laissez vide : une clé est générée et conservée dans jwt.key, à côté du fichier de base de données.
PRESSING_JWT_KEY=
# Compte administrateur créé au premier démarrage
PRESSING_ADMIN_USERNAME=admin
PRESSING_ADMIN_PASSWORD=Admin@2026!
# Données de démonstration (clients, commandes, paiements)
PRESSING_SEED_DEMO=true

# ---------- E-mail (Resend ou SMTP / mot de passe d'application) ----------
# auto | resend | smtp | simulated
EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Pressing Éclat
# Solution de repli : Gmail, Outlook, OVH... avec un mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_REPLY_TO=
# Traitement automatique de la file d'e-mails
EMAIL_BACKGROUND_ENABLED=true

# ---------- Rappels automatiques (v3, lot 3) ----------
# Toutes les 15 min, entre 8 h et 20 h : commande prête, non retirée (J+3, J+7, J+14 : un seul palier à la fois),
# solde restant quand la commande attend son retrait, veille de l'échéance. Uniquement pour les clients dont la
# fiche indique un canal (WhatsApp ou e-mail) : le choix du canal vaut consentement daté. false = aucun rappel.
REMINDERS_ENABLED=true

# ---------- WhatsApp (API WhatsApp Business Cloud de Meta) ----------
# simulated (défaut : rien ne part, les envois sont journalisés) | meta
WHATSAPP_PROVIDER=simulated
# Jeton d'accès et identifiant du numéro (Meta for Developers → WhatsApp → Configuration de l'API).
# Attention : hors de la fenêtre de 24 h après un message du client, Meta n'accepte que des MODÈLES approuvés :
# renseignez les WHATSAPP_TEMPLATE_* en fin de section (sinon les rappels partent en texte libre, utile en test).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Webhook (réponse « STOP » = désinscription) : URL publique https://<api>/api/public/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Modèles de messages approuvés par Meta (WhatsApp Manager → Modèles de messages, catégorie « Utilitaire »).
# Un nom par type de rappel ; vide = texte libre pour ce type. Variables du corps : {{1}} prénom, {{2}} ticket,
# puis {{3}} = montant du solde (BALANCE), date d'échéance jj/MM/aaaa (DUE) ou nombre de jours (UNCOLLECTED : 3, 7 ou 14).
# Procédure complète : README §6.5.
WHATSAPP_TEMPLATE_READY=
WHATSAPP_TEMPLATE_UNCOLLECTED=
WHATSAPP_TEMPLATE_BALANCE=
WHATSAPP_TEMPLATE_DUE=
# Demande d'avis (enquête de satisfaction, 2 h après le retrait) : {{1}} prénom, {{2}} ticket, {{3}} lien /avis?token=…
WHATSAPP_TEMPLATE_FEEDBACK=
# Code de langue des modèles (fr, fr_FR, en…), identique à celui choisi à la création du modèle.
WHATSAPP_TEMPLATE_LANGUAGE=fr

# ---------- Assistant vocal (lot M2) ----------
# Interrupteur général : false désactive les routes /api/assistant/* (réponse 503).
ASSISTANT_ENABLED=true
# Confiance minimale (0 à 1) en dessous de laquelle l'assistant répond « je n'ai pas compris ».
ASSISTANT_CONFIDENCE_THRESHOLD=0.6

# ---------- Sauvegardes automatiques (v3, lot 5) ----------
# Une sauvegarde vérifiée de la base par jour, dans PRESSING_BACKUP_PATH (fichiers pressing-auto-AAAAMMJJ-HHmmss.db).
# true (défaut) | false : false coupe les sauvegardes planifiées (la sauvegarde manuelle du Desktop reste disponible).
BACKUP_SCHEDULE_ENABLED=true
# Heure locale (0 à 23) à partir de laquelle la sauvegarde du jour est faite (défaut 22). Si l'API est arrêtée à
# cette heure, la sauvegarde est faite dès son redémarrage le même jour, une seule fois par jour.
BACKUP_HOUR=22
# Nombre de jours de conservation des sauvegardes AUTOMATIQUES (défaut 30). Les sauvegardes manuelles et celles
# « avant-migration » / « avant-adoption » ne sont jamais supprimées automatiquement.
BACKUP_RETENTION_DAYS=30
# Copie secondaire de chaque sauvegarde automatique : autre disque, clé USB, dossier synchronisé (OneDrive...).
# Même rotation que le dossier principal. Vide = pas de copie. Si le dossier est indisponible, l'erreur est
# journalisée et la sauvegarde locale est conservée.
BACKUP_COPY_PATH=
