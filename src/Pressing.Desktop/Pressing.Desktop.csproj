<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Pressing.Desktop</RootNamespace>
    <AssemblyName>Pressing.Desktop</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <!-- Mode sombre de Windows Forms (API encore marquée expérimentale). -->
    <NoWarn>$(NoWarn);WFO5001;WFO5002;WFO1000</NoWarn>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <Description>Application Desktop du personnel — Pressing Éclat</Description>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pressing.Client\Pressing.Client.csproj" />
  </ItemGroup>

</Project>
