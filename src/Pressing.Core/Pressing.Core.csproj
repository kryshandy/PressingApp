<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pressing.Core</RootNamespace>
    <AssemblyName>Pressing.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\assistant\prompt-systeme.txt" LogicalName="Pressing.Core.Assistant.prompt-systeme.txt" />
    <EmbeddedResource Include="..\..\tools\assistant\grammar.gbnf" LogicalName="Pressing.Core.Assistant.grammar.gbnf" />
    <EmbeddedResource Include="..\..\tools\assistant\intent-schema.json" LogicalName="Pressing.Core.Assistant.intent-schema.json" />
    <EmbeddedResource Include="..\..\tools\assistant\vocab-default.txt" LogicalName="Pressing.Core.Assistant.vocab-default.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
