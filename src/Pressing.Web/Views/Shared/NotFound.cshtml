@{
    ViewData["Title"] = "Page introuvable";
}
<section class="status-page">
    <div class="container status-inner">
        <p class="status-code" aria-hidden="true">404</p>
        <h1 class="display-1">Cette page s'est égarée</h1>
        <p class="page-lede">Comme une chaussette dans la machine : nous ne la retrouvons pas. Le lien est peut-être erroné ou la page a été déplacée.</p>
        <div class="status-actions">
            <a class="btn btn-ink" href="/">Retour à l'accueil</a>
            <a class="btn btn-ghost-ink" href="/suivi">Suivre ma commande</a>
        </div>
    </div>
</section>
