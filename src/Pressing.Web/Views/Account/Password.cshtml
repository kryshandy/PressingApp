@model ChangePasswordForm
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Mot de passe";
    ViewData["Section"] = "password";
}

<header class="account-head">
    <p class="eyebrow">Sécurité</p>
    <h1 class="display-2">Changer mon mot de passe</h1>
    <p class="muted">Choisissez un mot de passe que vous n'utilisez nulle part ailleurs.</p>
</header>

<form class="panel panel-narrow" method="post" action="/compte/mot-de-passe" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="flash flash-error" role="alert"></div>
    <div class="field">
        <label asp-for="CurrentPassword">Mot de passe actuel</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="NewPassword">Nouveau mot de passe</label>
        <div class="password-wrap">
            <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="6" required />
            <button type="button" class="pw-toggle" data-toggle-password="NewPassword" aria-label="Afficher le mot de passe">@Icons.Svg("eye", size: 20)</button>
        </div>
        <span class="hint">6 caractères minimum ; 10 ou plus est préférable.</span>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="ConfirmPassword">Confirmer le nouveau mot de passe</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <div class="form-actions">
        <button class="btn btn-ink" type="submit">Mettre à jour</button>
    </div>
</form>
